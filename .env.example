# Copy to .env and fill in. .env is gitignored and must never be committed.

# Model access. When unset, the system runs in saved-output mode, which replays
# stored model responses instead of calling the API. See acceptance criterion E2.
GEMINI_API_KEY=

# Postgres. Matches the service in docker-compose.yml.
DATABASE_URL=postgres://superjoin:superjoin@localhost:5432/superjoin

# Where uploaded PDFs and rendered page images are written.
STORAGE_DIR=./storage

# HTTP port for the API and web interface.
PORT=3000

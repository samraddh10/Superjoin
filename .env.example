# Copy to .env and fill in. .env is gitignored and must never be committed.
# Defaults below match packages/config; every value is a starting point to tune after
# Phase 8 measurement, not a claim about provider limits.

# --- Storage and database -----------------------------------------------------------
DATABASE_URL=postgres://superjoin:superjoin@localhost:55432/superjoin
STORAGE_DIR=./storage
PORT=3000

# --- Model access -------------------------------------------------------------------
# Leave empty to run in saved-output mode, which replays stored responses so the system
# can be evaluated without an API key. Only the worker calls OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google AI Studio speaks the same OpenAI-compatible protocol, so the client is unchanged.
# Point this at https://openrouter.ai/api/v1 instead to route through OpenRouter, and
# prefix the model name with `google/` if you do.
OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Must honour `response_format` with a JSON schema, which is the one hard requirement.
# Gemma does not: asked for a strict schema it answers in prose, Zod rejects it, and the
# run finishes with no claims rather than with bad ones. That failure is quiet enough to
# look like the pipeline being broken, so the default here is a model known to comply.
#
# Multimodal as well, because the difficult-page route sends a rendered page image.
#
# The free tier allows 500 requests per day per model, and a three-document collection
# spends more than that: extraction is roughly one call per chunk, and the Delhivery set
# chunks into over five hundred. Expect a full run to stop partway on a free key.
LLM_MODEL=gemini-3.1-flash-lite-preview

# --- Embeddings ---------------------------------------------------------------------
# Run locally with @huggingface/transformers. OpenRouter serves no embedding models, so
# these cannot come from the same provider. 768 dimensions, normalized.
# This must match the vector() column width; changing it invalidates stored vectors.
EMBEDDING_MODEL=Xenova/all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# --- Upload limits ------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300

# --- Processing budgets -------------------------------------------------------------
LLM_CONCURRENCY=2
CANDIDATE_TOP_K=15
DOCUMENT_TOKEN_BUDGET=1500000
LLM_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=5

# Copy to .env and fill in. .env is gitignored and must never be committed.
# Defaults below match packages/config; every value is a starting point to tune after
# Phase 8 measurement, not a claim about provider limits.

# --- Storage and database -----------------------------------------------------------
DATABASE_URL=postgres://superjoin:superjoin@localhost:55432/superjoin
STORAGE_DIR=./storage
PORT=3000

# --- Model access -------------------------------------------------------------------
# Leave empty to run in saved-output mode, which replays stored responses so the system
# can be evaluated without an API key. Only the worker calls OpenRouter.
# Get a key at https://openrouter.ai/keys
# --- Amazon Bedrock ---------------------------------------------------------------
# The region is the switch between live inference and replayed output. Bedrock is
# regional and model access is granted per region, so no live call can be made without
# one — which is what makes it an honest signal rather than a redundant flag. Leave it
# empty to run against recorded output with no AWS account at all.
AWS_REGION=us-east-1

# A Bedrock long-term API key -- what the console's "API key" button issues, exported as
# a CSV. It is a bearer token, not an access-key pair, so it cannot be split into an id
# and a secret. Set this OR the pair below, not both; this one wins.
AWS_BEARER_TOKEN_BEDROCK=

# Leave these empty when credentials come from an SSO profile, an instance role, or a
# task role: the AWS SDK's default chain finds those on its own. A blank value is read
# as absent, not as a credential.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model id or inference profile ARN.
#
# Two requirements: the model must accept tool use, because a JSON Schema is sent as a
# forced tool call rather than a response_format; and it must accept images, because
# difficult pages are rendered and transcribed.
#
# The default below satisfies the first but not the second, so the visual route fails and
# those pages fall back to native text. That is recorded as visual_route_failed rather
# than hidden. Anthropic models on Bedrock satisfy both if you need page transcription.
#
# Enable the model for your region first: Bedrock console -> Model access. Until you do,
# every call returns AccessDeniedException, which this pipeline reports without retrying.
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5

# --- Groq (second inference provider) ---------------------------------------------
# An OpenAI-compatible endpoint, so it needs only a key. Get one at console.groq.com.
#
# Which of the two providers actually serves a call is a runtime setting stored in
# app_settings and toggled from the application header -- not an environment variable.
# These lines only say what this deployment *can* reach; leaving the key empty means the
# Groq option appears in the header, disabled, with a tooltip saying why.
#
# The model must honour response_format with a JSON schema. gpt-oss-120b and
# qwen/qwen3.8-27b both do; groq/compound rejects the field outright.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---------------------------------------------------------------------
# Run locally with @huggingface/transformers. OpenRouter serves no embedding models, so
# these cannot come from the same provider. 768 dimensions, normalized.
# This must match the vector() column width; changing it invalidates stored vectors.
EMBEDDING_MODEL=Xenova/all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# --- Upload limits ------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300

# --- Processing budgets -------------------------------------------------------------
LLM_CONCURRENCY=2
CANDIDATE_TOP_K=15
DOCUMENT_TOKEN_BUDGET=1500000
LLM_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=5

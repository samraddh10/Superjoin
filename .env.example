# Copy to .env and fill in. .env is gitignored and must never be committed.
# Defaults below match packages/config; every value is a starting point to tune after
# Phase 8 measurement, not a claim about provider limits.

# --- Storage and database -----------------------------------------------------------
DATABASE_URL=postgres://superjoin:superjoin@localhost:55432/superjoin
STORAGE_DIR=./storage
PORT=3000

# --- Model access -------------------------------------------------------------------
# Required by the worker, which refuses to start without it: every document is processed
# by calling the model, and there is no offline mode to fall back to. The API never reads
# this and must not be given it.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Free and multimodal, which the difficult-page route needs. The :free suffix is part of
# the model's identity: the paid route is a different deployment.
#
# The mixture-of-experts model is the default on measured availability, not size: on the
# shared free pool the dense 31B returned 429 on 6 of 6 probes while this one answered 5
# of 6 at about 1.2s. Both free models draw on one upstream pool, so throttling is common
# either way; attaching your own Google AI Studio key at
# https://openrouter.ai/settings/integrations moves requests onto your own quota.
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# --- Embeddings ---------------------------------------------------------------------
# Run locally with @huggingface/transformers. OpenRouter serves no embedding models, so
# these cannot come from the same provider. 768 dimensions, normalized.
# This must match the vector() column width; changing it invalidates stored vectors.
EMBEDDING_MODEL=Xenova/all-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# --- Upload limits ------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300

# --- Processing budgets -------------------------------------------------------------
LLM_CONCURRENCY=2
CANDIDATE_TOP_K=15
DOCUMENT_TOKEN_BUDGET=1500000
LLM_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=5
